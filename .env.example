# Container paths
DOWNLOADS_PATH=/downloads
LIBRARY_PATH=/music
STATUS_FILE=/state/status.json

# Polling and stability (a file is ready after N unchanged scans)
SCAN_INTERVAL=60
STABLE_OBSERVATIONS=3

# Runtime identity; match ownership on bind mounts/NFS
PUID=1000
PGID=1000

# Host bind mounts
DOWNLOADS_HOST_PATH=./downloads
LIBRARY_HOST_PATH=./music
STATE_HOST_PATH=./state
